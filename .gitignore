# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Secrets / environment ─────────────────────────────────────
.env
.env.*
!.env.example

# ── Signing certificates & keystores (NEVER commit) ───────────
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.crt
*.key

# ── Runtime data (generated at run time) ──────────────────────
data/

# ── Your media library (never commit videos) ──────────────────
media/*
!media/.gitkeep
*.mkv
*.mp4
*.avi
*.mov
*.webm
*.m3u8
*.srt
*.vtt
*.ass

# ── App binaries (built artifacts — never commit) ─────────────
# Root-level APK (committed previously by mistake)
NexusNight.apk
# Deployment folders: keep the folder, ignore the binaries inside
directed/*.apk
directed/*.wgt
directed/*.aab
client/public/downloads/*.apk
client/public/downloads/*.wgt
client/public/downloads/*.aab

# ── Archives ──────────────────────────────────────────────────
*.zip
*.rar
*.7z
cloudflared.exe
cloudflared

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Test / coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Local dev / agent tooling (not part of source code) ───────
.agents/
.impeccable/review/*.png
.impeccable/surfaces/
.verify/
scripts/debug-sniff.js
scripts/test-arab-stream.js
scripts/check-es5.js

# ── Tizen TV build artifacts (already in NexusNightsTv/.gitignore)
NexusNightsTv/.buildResult/
NexusNightsTv/.sign/

# ── Editors / OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini